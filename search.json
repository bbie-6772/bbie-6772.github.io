---
layout: none
---
[
  {% assign first_search_item = true %}
  {% for post in site.posts %}
    {% unless first_search_item %},{% endunless %}
    {
      "title"    : {{ post.title | escape | jsonify }},
      "category" : {{ post.categories | join: ', ' | jsonify }},
      "tags"     : {{ post.tags | join: ', ' | jsonify }},
      "url"      : {{ site.baseurl | append: post.url | jsonify }},
      "date"     : {{ post.date | date: '%Y-%m-%d' | jsonify }},
      "desc"     : {{ post.subtitle | default: '' | strip_html | jsonify }},
      "headings" : {{ post.content | search_headings | jsonify }}
    }
    {% assign first_search_item = false %}
  {% endfor %}
  {% assign searchable_pages = site.pages | where_exp: 'page', 'page.title != nil' %}
  {% for page in searchable_pages %}
    {% unless first_search_item %},{% endunless %}
    {
      "title"    : {{ page.title | escape | jsonify }},
      "category" : {{ page.categories | join: ', ' | jsonify }},
      "tags"     : {{ page.tags | join: ', ' | jsonify }},
      "url"      : {{ site.baseurl | append: page.url | jsonify }},
      "date"     : {{ page.date | date: '%Y-%m-%d' | jsonify }},
      "desc"     : {{ page.subtitle | default: '' | strip_html | jsonify }},
      "headings" : {{ page.content | search_headings | jsonify }}
    }
    {% assign first_search_item = false %}
  {% endfor %}
]
