#!/bin/sh
# 스테이징된 _posts/*.md만 검사한다.
# ERROR면 커밋을 막고, WARN은 통과한다. 오탐이면 git commit --no-verify 로 넘긴다.
files=$(git diff --cached --name-only --diff-filter=d -- '_posts/*.md')
[ -z "$files" ] && exit 0
PY=$(command -v python3 || command -v python) || { echo "python 없음 — 검사 건너뜀"; exit 0; }
"$PY" scripts/post-lint.py $files
